# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_HOST_NAME=bluesky.example.com

APP_ORG_NAME=MyOrg

# Required: PDS admin password
APP_ADMIN_PASS=replace-with-a-random-password

# Required: JWT signing secret
APP_JWT_TOKEN=replace-with-a-random-32-character-hex-string

# Required: secp256k1 PLC rotation key as 64 hex characters (openssl rand -hex 32)
K256_PRIVATE_KEY=replace-with-a-random-64-character-hex-string

PUBLIC_IP=
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=587
EMAIL_SERVER_MAIL_FROM=no-reply@example.com
